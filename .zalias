#!/usr/bin/sh

eval "$(dircolors -b)"

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
alias ip='ip --color=auto'

# better cd
export FZF_DEFAULT_COMMAND="find"
# export FZF_DEFAULT_OPTS="--layout=reverse --height=40% --inline-info --border"
alias cdi='cd "./$(fd -Ht d 2>/dev/null | fzf)"'
alias cdq='cd ~/qmk/keyboards/mechboards/crkbd/pro/keymaps/colemak'

# ls/eza aliases
alias ls='eza --group-directories-first --ignore-glob="lost+found|*.synctex.gz"'
alias li='eza --group-directories-first -l --group --git --ignore-glob="lost+found|*.synctex.gz"'
alias la='eza --group-directories-first -la --group --git'
alias lt='eza --tree'

# other aliases
alias vim=nvim
alias dotfiles='/usr/bin/git --git-dir ~/.dotfiles/ --work-tree ~'
alias dots='dotfiles'
alias mkdir='mkdir -p'
alias history="history 0"
alias lslvm="lsblk -o NAME,FSTYPE,FSVER,FSUSED,FSSIZE,FSUSE%,MOUNTPOINTS /dev/nvme0n1p7"
alias lslv=lslvm
alias mutt=neomutt

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}
